.q-cat-badge {
  font-size: 0.75rem;
  font-weight: 700;
  color: #ff6b6b;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  background: rgba(255, 107, 107, 0.12);
  padding: 4px 10px;
  border-radius: var(--radius-pill);
}

.question-title {
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.5;
  color: var(--text-primary);
  word-break: keep-all;
}

.options-group {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-top: 20px;
}

.option-btn {
  width: 100%;
  min-height: 72px;
  padding: 16px 18px;
  background: var(--option-bg);
  border: 1.5px solid var(--option-border);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  text-align: left;
  display: flex;
  align-items: center;
  gap: 14px;
  position: relative;
  transition: all var(--transition-fast);
}

.option-btn:active {
  transform: scale(0.97);
  background: var(--option-active-bg);
  border-color: var(--option-active-border);
}

.option-badge {
  font-family: var(--font-accent);
  font-weight: 800;
  font-size: 1rem;
  width: 34px;
  height: 34px;
  min-width: 34px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff9a9e;
  transition: background var(--transition-fast), color var(--transition-fast);
}

.option-btn:active .option-badge {
  background: #ff6b6b;
  color: #fff;
}

.option-text {
  font-size: 0.98rem;
  font-weight: 500;
  line-height: 1.45;
  flex: 1;
  word-break: keep-all;
}

.check-icon {
  width: 22px;
  height: 22px;
  color: #ff6b6b;
  opacity: 0;
  transform: scale(0.5);
  transition: all var(--transition-fast);
}

.option-btn:active .check-icon {
  opacity: 1;
  transform: scale(1);
}

/* 9. Loading Screen */
#loadingScreen {
  justify-content: center;
  align-items: center;
  text-align: center;
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.spinner-ring {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.1);
  border-top-color: #ff6b6b;
  border-right-color: #ff8e53;
  animation: spin 1.2s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.spinner-core {
  font-size: 2.2rem;
  animation: pulseCore 1.2s ease-in-out infinite alternate;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes pulseCore {
  0% { transform: scale(0.85); }
  100% { transform: scale(1.15); }
}

.loading-title {
  font-size: 1.2rem;
  font-weight: 700;
}

.loading-subtext {
  font-size: 0.9rem;
  color: var(--text-muted);
}

/* 10. Result Screen */
#resultScreen {
  padding: 0;
}

.result-scroll-view {
  width: 100%;
  height: 100%;
  overflow-y: auto;
  padding: 24px 20px 36px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Custom scrollbar for result */
.result-scroll-view::-webkit-scrollbar {
  width: 4px;
}
.result-scroll-view::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-pill);
}

.result-header {
  text-align: center;
}

.result-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #ff9a9e;
  letter-spacing: -0.2px;
}

.result-title {
  font-size: 1.65rem;
  font-weight: 800;
  margin: 6px 0 8px;
  background: linear-gradient(135deg, #ffffff 0%, #ffd1ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  word-break: keep-all;
}

.result-subtitle {
  font-size: 0.92rem;
  color: var(--text-secondary);
  font-style: italic;
}

.result-avatar-card {
  position: relative;
  width: 130px;
  height: 130px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-emoji-large {
  font-size: 4.8rem;
  z-index: 2;
  filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.4));
  animation: floatEmoji 3s ease-in-out infinite alternate;
}

.avatar-glow {
  position: absolute;
  inset: -10px;
  background: var(--accent-gradient);
  border-radius: 50%;
  opacity: 0.3;
  filter: blur(25px);
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}

.tag {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 6px 12px;
  border-radius: var(--radius-pill);
  font-size: 0.82rem;
  font-weight: 600;
  color: #ffa69e;
}

.result-card-box {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-md);
  padding: 20px;
}

.box-title {
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: 14px;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 6px;
}

.desc-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.desc-list li {
  font-size: 0.92rem;
  color: var(--text-secondary);
  line-height: 1.55;
  position: relative;
  padding-left: 18px;
  word-break: keep-all;
}

.desc-list li::before {
  content: "•";
  position: absolute;
  left: 4px;
  color: #ff6b6b;
  font-size: 1.2rem;
  line-height: 1;
}

.chemistry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.chem-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-md);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.chem-label {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--text-muted);
}

.chem-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: #fff;
}

.chem-desc {
  font-size: 0.78rem;
  color: var(--text-secondary);
  line-height: 1.35;
}

.warning-box {
  background: rgba(239, 68, 68, 0.08);
  border-color: rgba(239, 68, 68, 0.25);
}

.warning-box .desc-list li::before {
  color: #f87171;
}

.community-box {
  background: rgba(59, 130, 246, 0.08);
  border-color: rgba(59, 130, 246, 0.25);
}

.community-box .desc-list li::before {
  color: #60a5fa;
}

.action-tip-box {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(52, 211, 153, 0.12) 100%);
  border: 1px solid rgba(52, 211, 153, 0.3);
}

.action-tip-text {
  font-size: 0.98rem;
  color: #a7f3d0;
  line-height: 1.5;
  font-weight: 700;
  text-align: center;
  padding: 4px 0;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 10px;
}

/* 11. Toast Notification */
.toast {
  position: fixed;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%) translateY(0);
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #fff;
  padding: 12px 22px;
  border-radius: var(--radius-pill);
  font-size: 0.88rem;
  font-weight: 600;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  z-index: 999;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
}

.toast.hidden {
  opacity: 0;
  transform: translateX(-50%) translateY(20px);
}

/* 12. Other Types Modal (2~5위 결과 보기) */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(8, 8, 16, 0.7);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-smooth);
}

.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

@media (min-width: 481px) {
  .modal-overlay {
    align-items: center;
  }
}

.modal-panel {
  width: 100%;
  max-width: 480px;
  max-height: 85vh;
  background: #16162a;
  background-image: var(--bg-gradient);
  border: 1px solid var(--card-border);
  border-bottom: none;
  border-radius: 22px 22px 0 0;
  box-shadow: var(--card-shadow);
  padding: 20px 20px 28px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transform: translateY(24px);
  transition: transform var(--transition-smooth);
  overflow: hidden;
}

.modal-overlay.show .modal-panel {
  transform: translateY(0);
}

@media (min-width: 481px) {
  .modal-panel {
    border-radius: var(--radius-lg);
    border-bottom: 1px solid var(--card-border);
    max-height: 80vh;
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.modal-title {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--text-primary);
}

.modal-close-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.14);
  width: 32px;
  height: 32px;
  min-width: 32px;
  border-radius: 50%;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.modal-close-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.18);
}

.modal-close-btn svg {
  width: 16px;
  height: 16px;
}

.modal-desc {
  font-size: 0.85rem;
  color: var(--text-muted);
  line-height: 1.5;
  word-break: keep-all;
}

.modal-list {
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-right: 2px;
}

.modal-list::-webkit-scrollbar {
  width: 4px;
}
.modal-list::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-pill);
}

/* Accordion cards for each other type */
.other-type-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.other-type-card[open] {
  border-color: rgba(255, 107, 107, 0.35);
}

.other-type-summary {
  list-style: none;
  cursor: pointer;
  padding: 14px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  user-select: none;
}

.other-type-summary::-webkit-details-marker {
  display: none;
}

.other-type-rank {
  font-family: var(--font-accent);
  font-weight: 800;
  font-size: 0.95rem;
  color: #ff9a9e;
  min-width: 20px;
}

.other-type-emoji {
  font-size: 1.6rem;
  min-width: 30px;
  text-align: center;
}

.other-type-headtext {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  gap: 2px;
}

.other-type-name {
  font-size: 0.98rem;
  font-weight: 700;
  color: var(--text-primary);
}

.other-type-sub {
  font-size: 0.76rem;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.other-type-score {
  font-family: var(--font-accent);
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.08);
  padding: 4px 8px;
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.other-type-chevron {
  width: 18px;
  height: 18px;
  color: var(--text-muted);
  transition: transform var(--transition-fast);
  flex-shrink: 0;
}

.other-type-card[open] .other-type-chevron {
  transform: rotate(180deg);
}

.other-type-body {
  padding: 0 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.other-type-body .result-tags {
  justify-content: flex-start;
}

.ot-section h4 {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.ot-section ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.ot-section ul li {
  font-size: 0.83rem;
  color: var(--text-secondary);
  line-height: 1.5;
  position: relative;
  padding-left: 14px;
  word-break: keep-all;
}

.ot-section ul li::before {
  content: "•";
  position: absolute;
  left: 2px;
  color: #ff6b6b;
}

.ot-section p {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.55;
  word-break: keep-all;
}
