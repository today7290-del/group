  <meta property="og:title" content="관계 스타일 테스트">
  <meta property="og:description" content="나에게 편안하고 힘이 되는 표현과 관계의 순간 알아보기">
  <meta property="og:type" content="website">

  <!-- Google Fonts: Inter & Noto Sans KR -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  
